rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile & Learning Data Documents
    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;

      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isOwner(userId) && isValidId(userId);

      // Nested subcollections
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }
  }
}

